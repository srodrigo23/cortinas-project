# Direccion del ESP32 en la red local. Acepta "192.168.1.50" o
# "192.168.1.50:8080". Para trabajar sin hardware, levantar el simulador
# (uv run python scripts/simular_esp32.py) y apuntar aca:
ESP32_IP=127.0.0.1:8080

# Ubicacion para el calculo de amanecer y atardecer (por defecto Cochabamba).
LAT=-17.3895
LON=-66.1568
TZ=America/La_Paz

# Cambiala antes de exponer el servidor fuera de la red local.
SECRET_KEY=cambiame-en-produccion
